model CustomerViolation {
  id          Int                   @id @default(autoincrement())
  timestamp   DateTime
  type        CustomerViolationType
  customer_id String?
  order_id    String?
  customer    Customer?             @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@map("customer_violations")
}

model UserReport {
  id            String       @id @default(cuid())
  reporter_id   String
  reported_id   String
  category      ReportReason
  description   String
  proof_url     String?
  status        ReportStatus @default(PENDING)
  admin_note    String?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  reported_user User         @relation("ReceivedReports", fields: [reported_id], references: [id], onDelete: Cascade)
  reporter      User         @relation("SentReports", fields: [reporter_id], references: [id], onDelete: Cascade)

  @@map("user_reports")
}

enum CustomerViolationType {
  ORDER_CANCEL_WITHOUT_PAY
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ReportReason {
  HARASSMENT
  FRAUD
  SPAM
  INAPPROPRIATE
  OTHER
}
